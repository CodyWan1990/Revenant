## ───── Windows ─────
# Action: Focus window left
bindsym $mod+h focus left
# Action: Focus window down
bindsym $mod+j focus down
# Action: Focus window up
bindsym $mod+k focus up
# Action: Focus window right
bindsym $mod+l focus right
# Action: Move window left
bindsym $mod+Shift+h move left
# Action: Move window down
bindsym $mod+Shift+j move down
# Action: Move window up
bindsym $mod+Shift+k move up
# Action: Move window right
bindsym $mod+Shift+l move right
# Action: Resize window left
bindsym $mod+Ctrl+h resize shrink width 10 px or 5 ppt
# Action: Resize window down
bindsym $mod+Ctrl+j resize grow height 10 px or 5 ppt
# Action: Resize window up
bindsym $mod+Ctrl+k resize shrink height 10 px or 5 ppt
# Action: Resize window right
bindsym $mod+Ctrl+l resize grow width 10 px or 5 ppt
# Action: Close window
bindsym $mod+q kill
# Action: Toggle floating
bindsym $mod+space floating toggle
# Action: Toggle tiling / floating focus
bindsym $mod+Shift+space focus mode_toggle
# Action: Toggle fullscreen
bindsym $mod+f fullscreen toggle
# Action: Split horizontally
bindsym $mod+y split h
# Action: Split vertically
bindsym $mod+u split v
# Action: Tabbed layout
bindsym $mod+w layout tabbed
# Action: Toggle split layout
bindsym $mod+Shift+w layout toggle split
