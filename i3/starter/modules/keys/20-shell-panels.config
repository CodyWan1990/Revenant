## ───── Shell panels ─────
# Action: Open app launcher
bindsym $mod+d exec --no-startup-id $qs launcher
# Action: Open settings
bindsym $mod+s exec --no-startup-id $qs settings
# Action: Open theme settings
bindsym $mod+t exec --no-startup-id $qs themes
# Action: Open wallpaper settings
bindsym $mod+Ctrl+w exec --no-startup-id $qs wallpaper
# Action: Open clipboard (text)
bindsym $mod+v exec --no-startup-id $qs clipboard
# Action: Open clipboard images
bindsym $mod+Shift+v exec --no-startup-id $qs clipimages
# Action: Open clipboard emoji
bindsym $mod+Shift+n exec --no-startup-id $qs emoji
# Action: Open notepad
bindsym $mod+n exec --no-startup-id $qs notepad
# Action: Show keybinds
bindsym $mod+slash exec --no-startup-id $qs keybinds
# Action: Open task manager
bindsym Ctrl+Shift+Escape exec --no-startup-id $qs processes
# Action: Switch windows
bindsym Mod1+Tab exec --no-startup-id $qs windowswitcher
