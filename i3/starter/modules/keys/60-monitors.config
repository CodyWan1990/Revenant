## ───── Monitors ─────
# Action: Focus monitor to the right
bindsym $mod+period exec --no-startup-id i3-msg focus output right
# Action: Focus monitor to the left
bindsym $mod+comma exec --no-startup-id i3-msg focus output left
# Action: Move window to monitor on the right
bindsym $mod+Shift+period exec --no-startup-id i3-msg move container to output right, focus output right
# Action: Move window to monitor on the left
bindsym $mod+Shift+comma exec --no-startup-id i3-msg move container to output left,  focus output left
# Action: Move workspace to monitor on the right
bindsym $mod+Ctrl+period exec --no-startup-id i3-msg move workspace to output right
# Action: Move workspace to monitor on the left
bindsym $mod+Ctrl+comma exec --no-startup-id i3-msg move workspace to output left
