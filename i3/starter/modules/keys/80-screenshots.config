## ───── Screenshots ─────
# Action: Capture region
bindsym Print exec --no-startup-id $shot region
# Action: Capture focused window
bindsym Shift+Print exec --no-startup-id $shot window
# Action: Capture monitor
bindsym $mod+Print exec --no-startup-id $shot screen
# Action: Capture menu with delay
bindsym $mod+Shift+Print exec --no-startup-id $shot menu
