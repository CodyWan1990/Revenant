# Shortcut sections, one file each in keys/, edited in Revenant's Settings → Keybinds.
# The shell's IPC and screenshot entry points (revenant.config defines the
# same as $rev / $rev_shot, but it is read after these binds).
set $qs qs -c revenant ipc call shell
set $shot ~/.config/quickshell/revenant/scripts/screenshot/screenshot-capture.sh
floating_modifier $mod
workspace_auto_back_and_forth yes

include keys/*.config
