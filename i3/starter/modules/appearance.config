## ───── Font ─────
# Window titles. A Nerd Font here matches the bar.
font pango:monospace 11

## ───── Window colours ─────
# Fallback until the first theme switch writes ~/.config/revenant/i3-colors.config.
set $bg        #2e3440
set $fg        #eceff4
set $accent    #81a1c1
set $invisible #3b4252
set $urgent    #bf616a

#class                  border      backgr.   text indicator   child_border
client.focused          $accent     $bg       $fg  $accent     $accent
client.focused_inactive $invisible  $bg       $fg  $invisible  $invisible
client.unfocused        $invisible  $bg       $fg  $invisible  $invisible
client.urgent           $urgent     $bg       $fg  $urgent     $urgent
client.placeholder      $invisible  $bg       $fg  $invisible  $invisible
client.background       $bg
