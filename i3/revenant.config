## ───── Revenant (Quickshell) ─────
# What i3 needs to host the shell. Include it from your i3 config, after
# your appearance settings so `border none` wins:
#     include ~/.config/quickshell/revenant/i3/revenant.config
# Then start the shell (once per login; it survives i3 restarts and
# hot-reloads its own QML):
#     exec --no-startup-id qs -c revenant
# Default shortcuts are in revenant-keys.config, next to this file.

# The shell's IPC and screenshot entry points, for your own binds:
#     bindsym $mod+d exec --no-startup-id $rev launcher
set $rev qs -c revenant ipc call shell
set $rev_shot ~/.config/quickshell/revenant/scripts/screenshot/screenshot-capture.sh

# Keyboard panels (launcher, clipboard, settings, power menu, …) are
# Quickshell FloatingWindows titled "revenant" (Quickshell sets no
# WM_CLASS). Every open re-maps the window, so these run each time: float,
# no border (the panel draws its own), centred on the focused output.
for_window [title="^revenant$"] floating enable, border none, move position center
for_window [title="^revenant$"] focus

# Screenshot selector: one window over every monitor showing the frozen
# capture. Floating so the tiled layout underneath is never resized; global
# fullscreen spans all outputs and hides the bars.
for_window [title="^revenant-shot$"] floating enable, border none, fullscreen enable global, focus

# Package upgrades open in a terminal with this class (Control Center →
# Updates).
for_window [class="^updatescratch$"] floating enable, resize set 40 ppt 40 ppt, move position center, focus
