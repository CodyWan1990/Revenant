## ───── Revenant default shortcuts ─────
# Optional: include after revenant.config (which defines $rev and
# $rev_shot) if you want these; Settings → Keybinds edits your own binds.
#     include ~/.config/quickshell/revenant/i3/revenant-keys.config
# The "# Action:" comments name each bind in the shell's cheat sheet ($mod+/).

# Action: Open app launcher
bindsym $mod+d exec --no-startup-id $rev launcher
# Action: Open settings
bindsym $mod+s exec --no-startup-id $rev settings
# Action: Open clipboard (text)
bindsym $mod+v exec --no-startup-id $rev clipboard
# Action: Open clipboard images
bindsym $mod+Shift+v exec --no-startup-id $rev clipimages
# Action: Open clipboard emoji
bindsym $mod+e exec --no-startup-id $rev emoji
# Action: Show keybinds
bindsym $mod+slash exec --no-startup-id $rev keybinds
# Action: Open task manager
bindsym Ctrl+Shift+Escape exec --no-startup-id $rev processes
# Action: Switch windows
bindsym Mod1+Tab exec --no-startup-id $rev windowswitcher
# Action: Power menu
bindsym $mod+Shift+e exec --no-startup-id $rev powermenu

# Action: Capture region
bindsym Print exec --no-startup-id $rev_shot region
# Action: Capture focused window
bindsym Shift+Print exec --no-startup-id $rev_shot window
# Action: Capture monitor
bindsym $mod+Print exec --no-startup-id $rev_shot screen
# Action: Capture with a 4 s delay (open a menu first)
bindsym $mod+Shift+Print exec --no-startup-id $rev_shot menu
