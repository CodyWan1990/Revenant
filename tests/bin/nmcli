#!/bin/sh
# Test stand-in for nmcli: canned devices and connections, and changes
# (up/down/modify/delete) only logged — no test touches the real network.
case "$*" in
    *"device show"*)
        printf 'GENERAL.DEVICE:eth0\nGENERAL.TYPE:ethernet\nGENERAL.STATE:100 (connected)\nGENERAL.CONNECTION:Wired one\nGENERAL.HWADDR:AA:BB:CC:DD:EE:FF\nCAPABILITIES.SPEED:1000 Mb/s\nIP4.ADDRESS[1]:192.0.2.10/24\nIP4.GATEWAY:192.0.2.1\nIP4.DNS[1]:192.0.2.53\nIP6.ADDRESS[1]:2001:db8::10/64\nIP6.GATEWAY:\n\nGENERAL.DEVICE:lo\nGENERAL.TYPE:loopback\nGENERAL.STATE:100 (connected (externally))\nGENERAL.CONNECTION:lo\nGENERAL.HWADDR:00:00:00:00:00:00\nCAPABILITIES.SPEED:unknown\n' ;;
    *"networking connectivity"*) echo full ;;
    *"connection show"*)
        printf 'Wired one:11111111-1111-1111-1111-111111111111:802-3-ethernet:eth0:yes:yes\nCafe\\: guest:22222222-2222-2222-2222-222222222222:802-11-wireless::yes:no\nWork VPN:33333333-3333-3333-3333-333333333333:vpn::no:no\nlo:44444444-4444-4444-4444-444444444444:loopback:lo:yes:yes\n' ;;
    *) echo "$*" >> "$HOME/nmcli.log" ;;
esac
